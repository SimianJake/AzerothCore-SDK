# Copy to tests/local.env (gitignored) and fill in your own test accounts and characters.
# Two existing characters, each on its own account whose name starts with ACSDK.HeadlessAccountPrefix:
ACSDK_TEST_CHARACTERS=Firstchar,Secondchar
# account:name:class for a mage (8) and a priest (5) the tests create on those same two accounts:
ACSDK_TEST_CASTERS=acsdkhcexample1:Firstmage:8,acsdkhcexample2:Secondpriest:5
