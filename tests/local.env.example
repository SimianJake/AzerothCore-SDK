# Copy to tests/local.env (gitignored) and fill in your own test accounts and characters.
# Two AzerothCore accounts the tests log in as (name:password), names starting with ACSDK.HeadlessAccountPrefix.
# Create them in the worldserver console: account create acsdkhcexample1 <password>
ACSDK_TEST_ACCOUNTS=acsdkhcexample1:password1,acsdkhcexample2:password2
# One existing character on each of those accounts, in the same order:
ACSDK_TEST_CHARACTERS=Firstchar,Secondchar
# account:name:class for a mage (8) and a priest (5) the tests create on those same two accounts:
ACSDK_TEST_CASTERS=acsdkhcexample1:Firstmage:8,acsdkhcexample2:Secondpriest:5
